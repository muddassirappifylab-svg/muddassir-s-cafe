---
/** The "Book a table" block that closes most pages, just above the footer. */
import {CAFE, whatsappUrl} from '../content/site';

interface Props {
  title?: string;
  body?: string;
}

const {title = 'Save yourself a seat by the plants.', body = `Book by WhatsApp, phone or the booking form. ${CAFE.bookingPromise}`} = Astro.props;
---

<section class="book-block" aria-labelledby="book-block-title">
  <div class="wrap">
    <h2 id="book-block-title">{title}</h2>
    <div>
      <p>{body}</p>
      <div class="actions">
        <a class="button" href="/book/">Book a table</a>
        <a class="button ghost" href={whatsappUrl()} rel="noopener noreferrer" target="_blank">WhatsApp us<span class="visually-hidden"> (opens WhatsApp)</span></a>
      </div>
    </div>
  </div>
</section>
