---
/**
 * Book a table. A static site cannot take bookings itself, so this page
 * offers WhatsApp, a call, and a form that opens a ready-to-send email or
 * WhatsApp message (src/scripts/mailto-form.ts). Nothing is stored here; the
 * café confirms by reply. Saving bookings online needs the app template.
 */
import {BOOK, CAFE, HOURS_SHORT, whatsappUrl} from '../content/site';
import Base from '../layouts/Base.astro';

// Half-hour slots from 8:00 AM to the last seating at 10:00 PM.
const slots: string[] = [];
for (let m = 8 * 60; m <= 22 * 60; m += 30) {
  const h = Math.floor(m / 60);
  slots.push(`${((h + 11) % 12) + 1}:${String(m % 60).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`);
}
---

<Base title={BOOK.title} description={BOOK.description}>
  <header class="wrap page-head">
    <h1>{BOOK.title}</h1>
    <p class="lede">{BOOK.lede}</p>
  </header>

  <div class="wrap book">
    <aside class="quick" aria-labelledby="quick-title">
      <h2 id="quick-title">Quickest: message or call</h2>
      <div class="quick-actions">
        <a class="button" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M3 17l1.2-3.6A7 7 0 1110 17a7 7 0 01-3.3-.8z"></path></svg>
          WhatsApp us<span class="visually-hidden"> (opens WhatsApp)</span>
        </a>
        <a class="button ghost" href={CAFE.phoneHref}>
          <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M4 3h3l1.5 4-2 1.2a9 9 0 004.3 4.3L12 10.5l4 1.5v3a2 2 0 01-2 2A12 12 0 012 5a2 2 0 012-2z"></path></svg>
          Call {CAFE.phone}
        </a>
      </div>
      <dl class="book-facts">
        <div>
          <dt>Opening hours</dt>
          {HOURS_SHORT.map(line => <dd>{line}</dd>)}
        </div>
        <div>
          <dt>Our promise</dt>
          <dd>{CAFE.bookingPromise} Bookings sent after closing are answered from 8:00 AM.</dd>
        </div>
        <div>
          <dt>Groups of 10 or more</dt>
          <dd>Have a look at the <a href="/events/">private dining room</a>.</dd>
        </div>
      </dl>
    </aside>

    <section class="book-form" aria-labelledby="form-title">
      <h2 id="form-title">Or send us the details</h2>
      <form
        class="form"
        action={`mailto:${CAFE.email}?subject=${encodeURIComponent('Table booking request')}`}
        method="post"
        enctype="text/plain"
        data-mailto={CAFE.email}
        data-whatsapp={CAFE.whatsapp}
        data-subject="Table booking request"
      >
        <div class="form-row">
          <div class="field">
            <label for="b-date">Date <span class="req" aria-hidden="true">*</span></label>
            <input id="b-date" name="Date" type="date" required aria-describedby="b-date-error" data-required="Choose a date." />
            <p id="b-date-error" class="error" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="b-time">Time <span class="req" aria-hidden="true">*</span></label>
            <select id="b-time" name="Time" required aria-describedby="b-time-hint b-time-error" data-required="Choose a time.">
              <option value="">Choose a time</option>
              {slots.map(s => <option>{s}</option>)}
            </select>
            <p id="b-time-hint" class="hint">Fridays from 2:00 PM. Last seating 10:00 PM.</p>
            <p id="b-time-error" class="error" aria-live="polite"></p>
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="b-guests">Guests <span class="req" aria-hidden="true">*</span></label>
            <input id="b-guests" name="Guests" type="number" inputmode="numeric" min="1" max="12" required aria-describedby="b-guests-error" data-required="How many people?" />
            <p id="b-guests-error" class="error" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="b-seat">Seating <span class="muted">(optional)</span></label>
            <select id="b-seat" name="Seating" aria-describedby="b-seat-error">
              <option value="">No preference</option>
              <option>By the window</option>
              <option>Among the plants</option>
              <option>Counter seats</option>
            </select>
            <p id="b-seat-error" class="error" aria-live="polite"></p>
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="b-name">Your name <span class="req" aria-hidden="true">*</span></label>
            <input id="b-name" name="Name" type="text" autocomplete="name" required data-sender aria-describedby="b-name-error" data-required="Tell us the name for the booking." />
            <p id="b-name-error" class="error" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="b-phone">Phone or WhatsApp <span class="req" aria-hidden="true">*</span></label>
            <input id="b-phone" name="Phone" type="tel" autocomplete="tel" required aria-describedby="b-phone-hint b-phone-error" data-required="Add a number so we can confirm." />
            <p id="b-phone-hint" class="hint">We confirm on this number.</p>
            <p id="b-phone-error" class="error" aria-live="polite"></p>
          </div>
        </div>
        <div class="field">
          <label for="b-notes">Anything we should know? <span class="muted">(optional)</span></label>
          <textarea id="b-notes" name="Notes" rows="3" aria-describedby="b-notes-hint b-notes-error"></textarea>
          <p id="b-notes-hint" class="hint">A birthday, a high chair, an allergy.</p>
          <p id="b-notes-error" class="error" aria-live="polite"></p>
        </div>
        <p class="small muted"><span class="req" aria-hidden="true">*</span> Required. Sending opens your email or WhatsApp with the booking filled in. Your table is held once we reply.</p>
        <div class="actions">
          <button class="button" type="submit" value="whatsapp" hidden data-js-only>Send on WhatsApp</button>
          <button class="button ghost" type="submit" value="email">Send by email</button>
        </div>
        <p class="form-status" role="status"></p>
      </form>
    </section>
  </div>
</Base>

<script>
  import '../scripts/mailto-form';
</script>

<style>
  .book {
    display: grid;
    gap: var(--space-2xl);
    padding-bottom: var(--space-4xl);
  }

  @media (min-width: 60rem) {
    .book {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-3xl);
      align-items: start;
    }

    .quick {
      position: sticky;
      top: 100px;
    }
  }

  .quick {
    padding: var(--space-lg);
    background: var(--color-paper-2);
    border-radius: var(--radius-md);
  }

  .quick h2,
  .book-form h2 {
    font-size: var(--text-xl);
  }

  .quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .book-facts {
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }

  .book-facts div {
    border-top: var(--rule-hair);
    padding-top: var(--space-sm);
  }

  .book-facts dt {
    font-weight: 600;
  }

  .book-facts dd {
    margin: 0;
    color: var(--color-ink-2);
  }
</style>
