---
/**
 * One page per tag in use: `/blog/tags/<tag>/`, built from the posts' `tags`
 * front matter. A tag nobody uses has no page.
 */
import PostCard from '../../../components/PostCard.astro';
import Base from '../../../layouts/Base.astro';
import {publishedPosts, tagsOf} from '../../../lib/posts';

export async function getStaticPaths() {
  return tagsOf(await publishedPosts()).map(tag => ({params: {tag: tag.slug}, props: {tag}}));
}

const {tag} = Astro.props;
const count = tag.posts.length;
---

<Base title={`News: ${tag.label}`} description={`${count} ${count === 1 ? 'story' : 'stories'} from Muddassir’s Café about ${tag.label}.`}>
  <header class="wrap page-head">
    <p><a href="/blog/">News</a></p>
    <h1>{tag.label}</h1>
    <p class="lede">{count} {count === 1 ? 'story' : 'stories'}.</p>
  </header>
  <section class="wrap" aria-label={`News about ${tag.label}`}>
    <ul class="post-list">
      {tag.posts.map((post, i) => (
        <li>
          <PostCard post={post} as="h2" eager={i < 3} />
        </li>
      ))}
    </ul>
    <p class="section-tight"><a href="/blog/">← All news</a></p>
  </section>
</Base>
