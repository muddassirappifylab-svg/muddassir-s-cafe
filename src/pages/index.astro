---
/**
 * Home: a full-bleed photo of the dining room with the café's one-line story,
 * today's specials, the menu highlights, guest reviews, Friday nights, the
 * latest news and the booking block. Words in src/content/site.ts.
 ok
 */
import {Picture} from 'astro:assets';

import diningRoom from '../assets/photos/dining-room.jpg';
import guitar from '../assets/photos/events-guitar.jpg';
import windowTable from '../assets/photos/window-table.jpg';
import BookBlock from '../components/BookBlock.astro';
import PostCard from '../components/PostCard.astro';
import Stars from '../components/Stars.astro';
import {CAFE, HOME, HOURS_SHORT} from '../content/site';
import Base from '../layouts/Base.astro';
import {cafeJsonLd} from '../lib/json-ld';
import {publishedPosts} from '../lib/posts';

const latest = (await publishedPosts()).slice(0, 3);
const taka = (n: number) => `BDT ${n.toLocaleString('en-US')}`;
const showSampleFlags = HOME.reviews.some(r => r.sample);
---

<Base jsonLd={cafeJsonLd()}>
  <section class="hero bleed" aria-labelledby="hero-title">
    <Picture
      src={diningRoom}
      alt={HOME.hero.alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1400, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-plate wrap">
      <h1 id="hero-title">{HOME.hero.title}</h1>
      <div class="hero-actions">
        <a class="button on-photo" href="/book/">Book a table</a>
        <a class="hero-link" href="/menu/">See the menu</a>
      </div>
    </div>
  </section>

  <section class="intro wrap section" aria-label="About the café">
    <p class="intro-text">{HOME.intro}</p>
    <dl class="intro-facts">
      <div>
        <dt>Where</dt>
        <dd>{CAFE.street}, {CAFE.area}</dd>
      </div>
      <div>
        <dt>When</dt>
        {HOURS_SHORT.map(line => <dd>{line}</dd>)}
      </div>
      <div>
        <dt>Tables</dt>
        <dd>Call, WhatsApp or <a href="/book/">book online</a></dd>
      </div>
    </dl>
  </section>

  <section class="specials" aria-labelledby="specials-title">
    <div class="wrap">
      <div class="specials-head">
        <h2 id="specials-title">Today’s specials</h2>
        <p class="hand specials-note">chalked up fresh, ask what’s left after 3!</p>
      </div>
      <ul class="specials-list">
        {
          HOME.specials.map(item => (
            <li class="special">
              <Picture
                src={item.image}
                alt={item.alt}
                formats={['avif', 'webp']}
                widths={[400, 640, 900]}
                sizes="(min-width: 64rem) 360px, (min-width: 48rem) 30vw, 78vw"
              />
              <p class="hand special-note">{item.note}</p>
              <h3>{item.name}</h3>
              <p class="special-desc">{item.description}</p>
              <p class="price">{taka(item.price)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <figure class="band bleed">
    <Picture src={windowTable} alt="A round table by the rainy window, set with a French press, cups and a potted chilli plant." formats={['avif', 'webp']} widths={[640, 1000, 1600]} sizes="100vw" />
    <figcaption>The window table, on a monsoon afternoon. Ask for it when you book.</figcaption>
  </figure>

  <section class="highlights wrap section" aria-labelledby="highlights-title">
    <div>
      <h2 id="highlights-title">What people come back for</h2>
      <p class="muted">Six plates and cups that have been on the menu since the early days, and probably always will be.</p>
      <p><a class="text-link" href="/menu/">The full menu</a></p>
    </div>
    <ul class="leaders">
      {
        HOME.highlights.map(item => (
          <li>
            <span class="leader-name">{item.name}</span>
            <span class="leader-dots" aria-hidden="true" />
            <span class="price">{taka(item.price)}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="reviews section" aria-labelledby="reviews-title">
    <div class="wrap reviews-head">
      <h2 id="reviews-title">From our regulars</h2>
      {showSampleFlags && <p class="small muted">Sample quotes for now. Real ones from guests are on their way.</p>}
    </div>
    <div class="reviews-track wrap" tabindex="0" role="region" aria-label="Guest reviews, scroll sideways for more">
      {
        HOME.reviews.map(review => (
          <figure class="review">
            <Stars value={review.stars} />
            <blockquote>
              <p>“{review.quote}”</p>
            </blockquote>
            <figcaption>
              <strong>{review.name}</strong>
              <span class="muted">{review.detail}</span>
              {review.sample && <span class="sample-flag">Sample review</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>
    <p class="wrap small muted scroll-hint" aria-hidden="true">Swipe or scroll for more →</p>
  </section>

  <section class="band bleed fridays" aria-labelledby="fridays-title">
    <Picture src={guitar} alt="" formats={['avif', 'webp']} widths={[640, 1000, 1600]} sizes="100vw" />
    <div class="wrap fridays-plate">
      <h2 id="fridays-title">Fridays, 8 PM: acoustic sets by the plants.</h2>
      <a class="hero-link" href="/events/">Events and private dining</a>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="wrap section" aria-labelledby="latest-title">
        <div class="news-head">
          <h2 id="latest-title">News from the café</h2>
          <a class="text-link" href="/blog/">All news</a>
        </div>
        <ul class="post-list">
          {latest.map(post => (
            <li>
              <PostCard post={post} showCover={false} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <BookBlock />
</Base>

<style>
  /* hero: the photograph is the headline; the line sits on it, bottom-left */
  .hero {
    height: min(86svh, 780px);
    min-height: 460px;
    display: grid;
  }

  .hero :global(picture),
  .band :global(picture) {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero :global(img),
  .band :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::after,
  .fridays::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, color-mix(in oklch, var(--color-scrim) 82%, transparent) 0%, transparent 62%);
  }

  .hero-plate {
    align-self: end;
    padding-bottom: var(--space-2xl);
    color: var(--color-on-photo);
  }

  .hero h1 {
    font-size: var(--text-display-s);
    line-height: 1.05;
    max-width: 17ch;
    margin: 0;
    color: var(--color-on-photo);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-lg);
  }

  .button.on-photo {
    background: var(--color-accent-deep);
    border-color: var(--color-accent-deep);
  }

  .button.on-photo:hover {
    background: var(--color-on-photo);
    border-color: var(--color-on-photo);
    color: var(--color-ink);
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-on-photo);
    font-weight: 600;
    white-space: nowrap;
  }

  .hero-link:hover {
    color: var(--color-on-photo);
    text-decoration-thickness: 2px;
  }

  .hero-link:focus-visible,
  .button.on-photo:focus-visible {
    outline-color: var(--color-on-photo);
  }

  /* intro: prose left, facts right */
  .intro {
    display: grid;
    gap: var(--space-xl);
  }

  .intro-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.4;
    margin: 0;
    max-width: 34ch;
  }

  .intro-facts {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    align-content: start;
  }

  .intro-facts div {
    border-top: var(--rule-hair);
    padding-top: var(--space-sm);
  }

  .intro-facts dt {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .intro-facts dd {
    margin: 0;
  }

  @media (min-width: 52rem) {
    .intro {
      grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
      gap: var(--space-3xl);
    }
  }

  /* specials: three cards; a swipeable strip on phones */
  .specials {
    background: var(--color-paper-2);
    padding-block: var(--space-3xl);
  }

  .specials-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .specials-head h2 {
    margin: 0;
  }

  .specials-note {
    margin: 0;
    font-size: var(--text-lg);
  }

  .specials-list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 78%);
    gap: var(--space-lg);
    margin: 0;
    padding: 0 0 var(--space-sm);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .special {
    scroll-snap-align: start;
    min-width: 0;
  }

  .special :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .special-note {
    margin: var(--space-sm) 0 var(--space-2xs);
    font-size: var(--text-lg);
    transform: rotate(-2deg);
    transform-origin: left;
  }

  .special h3 {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-2xs);
  }

  .special-desc {
    color: var(--color-ink-2);
    margin: 0 0 var(--space-xs);
  }

  .special .price {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .specials-list {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
    }
  }

  /* photo bands */
  .band {
    margin: 0;
    height: clamp(320px, 62vw, 640px);
    display: grid;
  }

  .band figcaption {
    align-self: end;
    justify-self: start;
    margin-bottom: var(--space-md);
    padding: var(--space-xs) var(--space-sm);
    width: auto;
    max-width: calc(100% - 2 * var(--gutter));
    margin-inline: var(--gutter);
    background: var(--color-paper);
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
  }

  @media (min-width: 75rem) {
    .band figcaption {
      margin-inline: calc((100% - 1180px) / 2);
    }
  }

  .fridays-plate {
    align-self: end;
    padding-bottom: var(--space-2xl);
  }

  .fridays h2 {
    color: var(--color-on-photo);
    font-size: var(--text-3xl);
    max-width: 18ch;
    margin: 0 0 var(--space-sm);
  }

  /* highlights: a printed-menu list with dotted leaders */
  .highlights {
    display: grid;
    gap: var(--space-xl);
  }

  .highlights h2 {
    max-width: 14ch;
  }

  .leaders {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .leaders li {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    padding-block: var(--space-sm);
    border-bottom: var(--rule-hair);
    font-size: var(--text-lg);
  }

  .leader-name {
    font-family: var(--font-display);
    min-width: 0;
  }

  .leader-dots {
    flex: 1;
    min-width: var(--space-lg);
    border-bottom: 2px dotted var(--color-rule-strong);
    transform: translateY(-0.3em);
  }

  @media (min-width: 52rem) {
    .highlights {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-3xl);
    }
  }

  /* reviews: a scroll-snap row; nothing moves on its own */
  .reviews {
    border-top: var(--rule-hair);
  }

  .reviews-head {
    margin-bottom: var(--space-lg);
  }

  .reviews-head p {
    margin: 0;
  }

  .reviews-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 86%);
    gap: var(--space-lg);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    padding-bottom: var(--space-md);
  }

  @media (min-width: 48rem) {
    .reviews-track {
      grid-auto-columns: minmax(0, calc((100% - 2 * var(--space-lg)) / 2.4));
    }
  }

  .review {
    scroll-snap-align: start;
    margin: 0;
    padding: var(--space-lg);
    background: var(--color-paper-2);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .review blockquote {
    margin: 0;
    flex: 1;
  }

  .review blockquote p {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.45;
    margin: 0;
  }

  .review figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-sm);
    font-size: var(--text-sm);
  }

  .scroll-hint {
    margin-top: var(--space-xs);
  }

  .news-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-xs) var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .news-head h2 {
    margin: 0;
  }
</style>
