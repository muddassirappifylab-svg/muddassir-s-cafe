---
/**
 * Visit us: address, map (OpenStreetMap embed, allowed in `frame-src` in
 * astro.config.mjs), hours with today highlighted (src/scripts/today-hours.ts),
 * parking and landmark notes, call / directions buttons and a message form
 * that opens a ready-to-send email (src/scripts/mailto-form.ts).
 * Facts in CAFE and HOURS in src/content/site.ts.
 */
import {CAFE, HOURS, SITE, VISIT, clock, directionsUrl, fullAddress, whatsappUrl} from '../content/site';
import Base from '../layouts/Base.astro';
import {cafeJsonLd} from '../lib/json-ld';

const d = 0.006;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${CAFE.lng - d},${CAFE.lat - d * 0.7},${CAFE.lng + d},${CAFE.lat + d * 0.7}&layer=mapnik&marker=${CAFE.lat},${CAFE.lng}`;
const mapLink = `https://www.openstreetmap.org/?mlat=${CAFE.lat}&mlon=${CAFE.lng}#map=17/${CAFE.lat}/${CAFE.lng}`;
---

<Base title={VISIT.title} description={VISIT.description} jsonLd={cafeJsonLd()}>
  <header class="wrap page-head">
    <h1>{VISIT.title}</h1>
    <p class="lede">{VISIT.lede}</p>
    <p class="open-status" data-open-status hidden></p>
  </header>

  <section class="wrap where" aria-labelledby="where-title">
    <div class="where-text">
      <h2 id="where-title">Where to find us</h2>
      <address>
        {SITE.name}<br />
        {CAFE.street}<br />
        {CAFE.area}, {CAFE.city} {CAFE.postcode}
      </address>
      <div class="actions">
        <a class="button" href={directionsUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M10 18s6-5.3 6-10a6 6 0 10-12 0c0 4.7 6 10 6 10z"></path><circle cx="10" cy="8" r="2.2"></circle></svg>
          Get directions<span class="visually-hidden"> (opens Google Maps in a new tab)</span>
        </a>
        <a class="button ghost" href={CAFE.phoneHref}>
          <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M4 3h3l1.5 4-2 1.2a9 9 0 004.3 4.3L12 10.5l4 1.5v3a2 2 0 01-2 2A12 12 0 012 5a2 2 0 012-2z"></path></svg>
          Call {CAFE.phone}
        </a>
      </div>
      <h3>Finding us</h3>
      <p>{CAFE.landmark}</p>
      <h3>Parking</h3>
      <p>{CAFE.parking}</p>
    </div>
    <figure class="map">
      <iframe
        src={mapSrc}
        title={`Map showing Muddassir’s Café at ${fullAddress}`}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
      <figcaption class="caption"><a href={mapLink} target="_blank" rel="noopener noreferrer">Open the larger map<span class="visually-hidden"> (new tab)</span></a></figcaption>
    </figure>
  </section>

  <section class="wrap section hours-wrap" aria-labelledby="hours-title">
    <div>
      <h2 id="hours-title">Opening hours</h2>
      <p class="muted">Friday mornings are for family. We open after Jumu’ah prayers.</p>
    </div>
    <table class="hours" data-hours>
      <caption class="visually-hidden">Opening hours, Saturday to Friday</caption>
      <tbody>
        {
          HOURS.map(h => (
            <tr data-day={h.label} data-open={h.open} data-close={h.close} data-open-label={clock(h.open)} data-close-label={clock(h.close)}>
              <th scope="row">{h.label}</th>
              <td class="tabular">
                {clock(h.open)} – {clock(h.close)}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="contact-wrap" aria-labelledby="contact-title">
    <div class="wrap section contact">
      <div>
        <h2 id="contact-title">Get in touch</h2>
        <p>For a table tonight, WhatsApp or a call is quickest. For anything else, send us a message.</p>
        <ul class="ways">
          <li>
            <span class="way-label">Phone</span>
            <a href={CAFE.phoneHref}>{CAFE.phone}</a>
          </li>
          <li>
            <span class="way-label">WhatsApp</span>
            <a href={whatsappUrl('Hi! I have a question for Muddassir’s Café.')} target="_blank" rel="noopener noreferrer">Message us<span class="visually-hidden"> (opens WhatsApp)</span></a>
          </li>
          <li>
            <span class="way-label">Email</span>
            <a href={`mailto:${CAFE.email}`}>{CAFE.email}</a>
          </li>
        </ul>
        <p class="small muted">Booking a table? Use the <a href="/book/">booking page</a>.</p>
      </div>

      <form class="form" action={`mailto:${CAFE.email}`} method="post" enctype="text/plain" data-mailto={CAFE.email} data-subject="Message from the website">
        <div class="form-row">
          <div class="field">
            <label for="c-name">Your name <span class="req" aria-hidden="true">*</span></label>
            <input id="c-name" name="Name" type="text" autocomplete="name" required data-sender aria-describedby="c-name-error" data-required="Tell us who to reply to." />
            <p id="c-name-error" class="error" aria-live="polite"></p>
          </div>
          <div class="field">
            <label for="c-phone">Phone <span class="muted">(optional)</span></label>
            <input id="c-phone" name="Phone" type="tel" autocomplete="tel" aria-describedby="c-phone-error" />
            <p id="c-phone-error" class="error" aria-live="polite"></p>
          </div>
        </div>
        <div class="field">
          <label for="c-message">Message <span class="req" aria-hidden="true">*</span></label>
          <textarea id="c-message" name="Message" rows="5" required aria-describedby="c-message-error" data-required="Write your message."></textarea>
          <p id="c-message-error" class="error" aria-live="polite"></p>
        </div>
        <p class="small muted"><span class="req" aria-hidden="true">*</span> Required. Sending opens your email app with the message filled in.</p>
        <div class="actions">
          <button class="button" type="submit" value="email">Send message</button>
        </div>
        <p class="form-status" role="status"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  import '../scripts/today-hours';
  import '../scripts/mailto-form';
</script>

<style>
  .open-status {
    display: inline-block;
    margin: var(--space-sm) 0 0;
    padding: var(--space-2xs) var(--space-sm);
    border: 1px solid var(--color-rule-strong);
    border-radius: 999px;
    font-weight: 600;
  }

  .where {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: var(--space-3xl);
  }

  address {
    font-style: normal;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.35;
  }

  .where-text h3 {
    margin: var(--space-xl) 0 var(--space-2xs);
  }

  .where-text p {
    max-width: 48ch;
  }

  .map {
    margin: 0;
  }

  .map iframe {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    background: var(--color-paper-3);
  }

  @media (min-width: 60rem) {
    .where {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: var(--space-3xl);
    }
  }

  .hours-wrap {
    display: grid;
    gap: var(--space-lg);
    border-top: var(--rule-hair);
  }

  @media (min-width: 52rem) {
    .hours-wrap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: var(--space-3xl);
    }
  }

  .hours {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-lg);
  }

  .hours th,
  .hours td {
    padding: var(--space-sm) var(--space-sm);
    border-bottom: var(--rule-hair);
    text-align: left;
  }

  .hours th {
    font-weight: 400;
  }

  .hours td {
    text-align: right;
    white-space: nowrap;
  }

  .hours tr:global(.is-today) {
    background: var(--color-paper-2);
  }

  .hours tr:global(.is-today) th,
  .hours tr:global(.is-today) td {
    font-weight: 600;
    border-bottom: 2px solid var(--color-accent);
  }

  .hours :global(.today) {
    display: inline-block;
    margin-left: var(--space-xs);
    padding: 0 var(--space-xs);
    font-size: var(--text-xs);
    border-radius: var(--radius-sm);
    background: var(--color-accent-deep);
    color: var(--color-accent-ink);
    vertical-align: middle;
  }

  .contact-wrap {
    background: var(--color-paper-2);
  }

  .contact {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 60rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
      gap: var(--space-3xl);
    }
  }

  .ways {
    margin: var(--space-lg) 0;
    padding: 0;
    list-style: none;
  }

  .ways li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: var(--rule-hair);
  }

  .way-label {
    min-width: 6rem;
    color: var(--color-muted);
  }

  .field input,
  .field textarea {
    background: var(--color-paper);
  }
</style>
